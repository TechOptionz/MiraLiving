# Brochure form -> email delivery via Resend.
#
# The /api/brochure route emails each validated lead to BROCHURE_RECIPIENTS
# from enquiries@miraliving.com.au, with Reply-To set to the submitter.
# If either variable is not set, the visitor still receives the brochure and
# the lead is written to the server log only (the thank-you then makes no
# promise of a call back). Once both are set, a failed send is reported to the
# visitor as an error, never as a success. Every lead is logged regardless.

# Server-side only - never prefix with NEXT_PUBLIC_.
RESEND_API_KEY=

# Comma-separated list of addresses that receive each brochure request.
BROCHURE_RECIPIENTS=
