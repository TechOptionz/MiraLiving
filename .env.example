# Brochure form -> CRM delivery.
#
# The /api/brochure route forwards each validated lead to this webhook as JSON.
# If this is not set, the form returns an error and tells the visitor to phone
# the sales team; it will NOT report a false success. Every lead is also written
# to the server log regardless, so nothing is lost while this is being wired up.
BROCHURE_WEBHOOK_URL=

# Optional. Sent as "Authorization: Bearer <token>" with the webhook request.
BROCHURE_WEBHOOK_TOKEN=
