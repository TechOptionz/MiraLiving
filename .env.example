# Brochure form -> CRM delivery.
#
# The /api/brochure route forwards each validated lead to this webhook as JSON.
# If this is not set, the visitor still receives the brochure and the lead is
# written to the server log only (the thank-you then makes no promise of a
# call back). Once it is set, a failed delivery is reported to the visitor as
# an error, never as a success. Every lead is logged regardless.
BROCHURE_WEBHOOK_URL=

# Optional. Sent as "Authorization: Bearer <token>" with the webhook request.
BROCHURE_WEBHOOK_TOKEN=
